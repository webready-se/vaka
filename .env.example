# Base URL for this Vaka instance (used in alert links).
# Example: https://vaka.example.com
APP_URL=

# Time zone for the CLI and alert messages (stored times are UTC).
TIMEZONE=Europe/Stockholm

# Database and users file (relative to the project root).
DB_PATH=data/vaka.sqlite
USERS_FILE=users.json

# Session lifetime in seconds (default: 30 days).
SESSION_LIFETIME=2592000

# Brute-force protection: failed logins per IP address within LOCKOUT_MINUTES.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Reverse proxies in front of Vaka (comma-separated IPs or CIDR ranges). Only
# requests from these may set the client IP via X-Forwarded-For / X-Real-IP.
# Leave empty when clients connect directly (Nginx + PHP-FPM, Forge).
TRUSTED_PROXIES=

# --- Checks ------------------------------------------------------------------

# Default minutes between uptime checks (a site can override it).
# A failing site is rechecked on every run regardless.
UPTIME_INTERVAL=5

# Seconds before a request counts as failed.
UPTIME_TIMEOUT=10

# Consecutive failed uptime checks before a site counts as down.
DOWN_AFTER_FAILURES=2

# Days before expiry to alert (comma-separated, each alerts once).
SSL_ALERT_DAYS=14,7,1
DOMAIN_ALERT_DAYS=30,14,7,1

# Days to keep uptime samples (response times, uptime percentage).
SAMPLES_RETENTION_DAYS=30

# A CA bundle (PEM) to verify certificates against instead of the system's.
# Only for sites with certificates from an internal authority. Empty = system.
SSL_CA_FILE=

# User-Agent sent with every check. Empty = "Vaka/<version> (+<APP_URL>)".
USER_AGENT=

# --- Watching Vaka itself ----------------------------------------------------

# Pinged (GET) at the end of every run. Point it at a dead man's switch such as
# Healthchecks.io (free tier): it alerts you when the pings stop, for example
# because cron stopped or the server Vaka runs on went down.
# Example: https://hc-ping.com/your-uuid
HEARTBEAT_URL=

# --- Alerts ------------------------------------------------------------------
# Defaults for groups that have no destination of their own (set per group with
# `php vaka group:edit`). Leave a channel empty to turn it off.
# Webhook URLs are secrets.

# Local time (TIMEZONE) when groups with the digest policy get their daily summary.
DIGEST_TIME=08:00

# Slack incoming webhook (https://api.slack.com/messaging/webhooks).
SLACK_WEBHOOK_URL=

# Generic webhook: receives a JSON POST for every alert.
WEBHOOK_URL=

# Email via PHP mail(). Needs a working MTA on the server (sendmail/postfix);
# many hosts have none. Comma-separated recipients.
ALERT_EMAIL=
ALERT_FROM=
